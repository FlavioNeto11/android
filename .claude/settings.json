{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks\"; [ -f \"$d/python.sh\" ] || exit 0; exec sh \"$d/python.sh\" guarda.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/.claude/workflows/*.js)",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks\"; [ -f \"$d/python.sh\" ] || exit 0; exec sh \"$d/python.sh\" workflow-js.py",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Write(**/.claude/workflows/*.js)",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks\"; [ -f \"$d/python.sh\" ] || exit 0; exec sh \"$d/python.sh\" workflow-js.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
