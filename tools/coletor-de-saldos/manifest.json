{
  "manifest_version": 3,
  "name": "Coletor de saldos da Central",
  "version": "1.0.0",
  "description": "Lê o saldo das contas de IA (Anthropic, OpenAI, Google AI Studio) na sessão deste Chrome e registra na Central de Aparelhos. Só o número sai do navegador.",
  "key": "",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://platform.claude.com/*",
    "https://platform.openai.com/*",
    "https://aistudio.google.com/*",
    "https://payments.google.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": { "service_worker": "trabalhador.js" },
  "content_scripts": [
    {
      "matches": ["https://platform.claude.com/settings/billing*"],
      "js": ["leitura.js", "pagina.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://platform.openai.com/settings/organization/billing/*"],
      "js": ["leitura.js", "pagina.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://payments.google.com/*"],
      "js": ["leitura.js", "pagina.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "opcoes.html"
}
