<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        style="@style/HeaderBar"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/profile_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profile_title"
                style="@style/HeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_title" />

            <TextView
                android:id="@+id/profile_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/on_primary_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/profile_saved_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_success"
                android:padding="12dp"
                android:textColor="@color/success_text"
                android:textSize="15sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/profile_name"
                style="@style/FormField"
                android:hint="@string/profile_name_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1" />

            <EditText
                android:id="@+id/profile_email"
                style="@style/FormField"
                android:hint="@string/profile_email_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

            <EditText
                android:id="@+id/profile_city"
                style="@style/FormField"
                android:hint="@string/profile_city_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLines="1" />

            <CheckBox
                android:id="@+id/profile_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/profile_notifications"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/profile_save"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/profile_save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
