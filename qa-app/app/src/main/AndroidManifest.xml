<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        QA Messenger: app EXCLUSIVO de QA (alvo de automacao). Contas e PIN sao ficticios.
        O ContentProvider e exportado SEM permissao de proposito, para verificacao independente
        e injecao de falhas via adb. Nunca reutilize este padrao em um app de producao.
    -->
    <application
        android:name=".QaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- exported + singleTop: permite provisionar login via "am start ... -es account ... -es pin ..." -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <provider
            android:name=".QaProvider"
            android:authorities="com.pocqa.messenger.provider"
            android:exported="true" />

    </application>

</manifest>
