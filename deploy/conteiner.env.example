# Copie para deploy/.env (fora do Git pela regra `.env` do .gitignore; fora da imagem pelo .dockerignore) e preencha.
# É o env_file do serviço `central` em deploy/compose.yaml. Nada aqui entra na imagem: é lido em tempo de execução.
#
# O que o compose FIXA e este arquivo não muda (fica em `environment:`, que ganha do env_file): OWNER_ID, ROLE,
# AI_PROVIDER=simulated, POC_CONFIG e CONTAINER_LISTEN_HOST.

# OBRIGATÓRIO. Pela porta publicada o par é o gateway do Docker, nunca loopback: o painel pede este token no login
# e o backend recusa subir sem ele. Gere com:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=

# Chave mestra do cofre de credenciais (base64 de 32 bytes). No Linux não há DPAPI: sem ela o /api/health acusa
# `secret_store_unavailable` e nenhuma credencial é guardada. Gere com:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Para abrir credenciais de um banco vindo do Windows, a chave tem de ser a MESMA que recifrou aquele banco
# (rekey no Windows, antes da cópia) — docs/operacao.md, "Contêineres".
CREDENTIALS_MASTER_KEY=

# --- Só com `--profile postgres` ------------------------------------------------------------------------------
# A senha é lida pelo serviço postgres (interpolação do compose). A URL é a do central; sem ela, o central fica
# no SQLite do volume mesmo com o postgres no ar. Rede interna do compose, mesma máquina: sem TLS aqui.
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://farm:<a mesma senha>@postgres:5432/farm

# --- Só se trocar AI_PROVIDER no compose (chamada paga exige autorização do dono) ----------------------------
# ANTHROPIC_API_KEY=
